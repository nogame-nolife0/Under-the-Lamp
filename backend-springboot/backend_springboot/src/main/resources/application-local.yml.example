# 复制此文件为 application-local.yml 并填入真实密码

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/paper-generator-system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: your_mysql_password
  data:
    redis:
      host: 192.168.167.130
      port: 6379
      password: your_redis_password
      database: 0
      timeout: 5000ms
