# 复制为 .env，或直接依赖系统环境变量 DOUBAO_API_KEY

# 豆包 / 火山方舟（OpenAI 兼容接口）
DOUBAO_API_KEY=your_ark_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 在火山方舟控制台创建推理接入点，填入 ep-xxxxxxxx 或模型名称
DOUBAO_MODEL=ep-20260604170625-bh6xz
# Embedding 接入点（智能组卷向量化，选 Doubao-embedding-vision 版本如 251215）
DOUBAO_EMBEDDING_MODEL=ep-your-embedding-endpoint
# vision 模型用 multimodal；若仍使用旧版纯文本模型则填 text
DOUBAO_EMBEDDING_MODE=multimodal

# Chroma 向量库持久化目录
CHROMA_PERSIST_DIR=./data/chroma

# 服务端口
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
